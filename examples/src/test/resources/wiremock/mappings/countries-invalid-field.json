{
  "name": "Countries: query with an unknown field",
  "request": {
    "method": "POST",
    "urlPath": "/graphql",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.operationName == 'CountryWithUnknownField')]"
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "errors": [
        {
          "message": "Cannot query field \"population\" on type \"Country\".",
          "locations": [
            {
              "line": 4,
              "column": 5
            }
          ],
          "extensions": {
            "code": "GRAPHQL_VALIDATION_FAILED"
          }
        }
      ]
    }
  }
}
