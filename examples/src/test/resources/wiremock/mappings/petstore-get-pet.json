{
  "name": "Petstore: get any pet (id taken from the path)",
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/v3/pet/[0-9]+"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": [
      "response-template"
    ],
    "body": "{\"id\": {{request.path.[3]}}, \"name\": \"doggie\", \"category\": {\"id\": 1, \"name\": \"Dogs\"}, \"photoUrls\": [\"https://example.org/doggie.png\"], \"tags\": [{\"id\": 1, \"name\": \"friendly\"}], \"status\": \"available\"}"
  }
}
