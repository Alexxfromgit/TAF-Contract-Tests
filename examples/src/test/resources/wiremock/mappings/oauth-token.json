{
  "name": "Fake identity provider: client-credentials token",
  "request": {
    "method": "POST",
    "urlPath": "/oauth/token",
    "bodyPatterns": [
      {
        "contains": "grant_type=client_credentials"
      },
      {
        "contains": "client_id=demo-client"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "stub-access-token",
      "token_type": "Bearer",
      "expires_in": 3600,
      "scope": "profile:read"
    }
  }
}
