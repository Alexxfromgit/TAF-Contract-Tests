{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet list",
  "type": "array",
  "items": {
    "$ref": "#/$defs/pet"
  },
  "$defs": {
    "pet": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Used by the app to open pet details"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "photoUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "status": {
          "enum": [
            "available",
            "pending",
            "sold"
          ]
        }
      }
    }
  }
}
